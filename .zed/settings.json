{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "linkedProjects": ["kernel/Cargo.toml"],
        "cargo": {
          "buildScripts": {
            "enable": true,
          },
          "sysroot": "discover",
          "extraArgs": ["-Z", "json-target-spec"],
          "test": false,
        },
        "check": {
          "allTargets": false,
          "extraArgs": ["-Z", "json-target-spec"],
        },
      },
    },
  },
}
